---
import { Image } from 'astro:assets'

import Card from '../components/card.astro'
import Hero from '../components/hero.astro'
import Icon from '../components/icon.astro'
import Link from '../components/link.astro'
import Section from '../components/section.astro'
import Tag from '../components/tag.astro'
import Text from '../components/text.astro'

import Layout from '../layouts/main.astro'

import heroImage from '../images/communile-hero.jpg'
import leBarIleCardImage from '../images/le-bar-ile-card.jpg'
import leLaboDivaCardImage from '../images/le-labo-diva-card.jpg'
import leWattigniesCardImage from '../images/le-wattignies-card.jpg'
import lesLandesFertilesCardImage from '../images/les-landes-fertiles-card.jpg'

import illuAccompagnerTransitionImage from '../images/communile-illu-accompagner-transition.png'
import illuCreerLienImage from '../images/communile-illu-creer-lien.png'
import illuCreerModeleImage from '../images/communile-illu-creer-modele.png'

import ShapeWaves01 from '../images/shape-waves-01.svg'
import ShapeWaves02 from '../images/shape-waves-02.svg'

import { PATH } from '../utils/constants'
---

<Layout>
	<Hero
		title="Archipel de(s) communs"
		image={heroImage}
		imageAlt="Un mur peint avec les couleurs du logo. Le fond est bleu, des plantes rouges serpentent le long du mur. En haut, Commun'île est écrit en gros, en jaune. Les différents noms de lieux sont écrits de part et d'autre, en gris. Des photos Polaroid de différents moments de vie sont collées sur le mur."
	/>

	<Section class="space-y-3">
		<h2 class="grid grid-rows-2 justify-items-start text-white uppercase font-pally font-bold text-5xl leading-normal">
			<span class="inline-block rounded-full bg-primary px-4 -rotate-7">Nos</span>
			<span class="inline-block rounded-full bg-secondary px-4 rotate-4 -translate-y-2">lieux</span>
		</h2>
		
		<Text>
			Commun'île c'est avant tout une histoire de lieux et de personnes qui les composent. 
		</Text>
		<Text>
			Des lieux où chacun·e pourra toujours bien manger, boire un coup et passer du bon temps.
		</Text>
		<Text>
			Des lieux où règne le respect : celui des client·es d'un jour et de toujours, celui des travailleurs, des produits, de notre quartier, de notre ville
		</Text>

		<Link
			href={PATH.LE_WATTIGNIES}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={leWattigniesCardImage}
				alt="Le Wattignies - bar et restaurant avec une façade vitrée, un comptoir bleu et des tables"
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="blue" class="absolute top-4 left-4 uppercase">
					Le Wattignies
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d’ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>

		<Link 
			href={PATH.LES_LANDES_FERTILES}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={lesLandesFertilesCardImage}
				alt="Les Landes Fertiles - 2 personnes travaillent sur des plants de tomates"
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="red" class="absolute top-4 left-4 uppercase">
					Les Landes Fertiles
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d’ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>
		
		<Link
			href={PATH.LE_LABO_DIVA}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={leLaboDivaCardImage}
				alt="Le Labo Diva - Un bar intérieur composé de lattes de bois peintes en vert, jaune, blanc ou orange."
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="green" class="absolute top-4 left-4 uppercase">
					Le Labo Diva
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d'ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>

		<Link
			href={PATH.LE_BAR_ILE}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={leBarIleCardImage}
				alt="Le Bar Ile - Une terrasse d'un bar, les murs extérieurs sont bleus foncés. Un marché est installé avec des légumes."
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="blue" class="absolute top-4 left-4 uppercase">
					Le Bar’Île
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d’ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>
	</Section>

	<Section class="space-y-6">
		<h2 class="text-2xl text-center font-medium font-pally">
			Commun’Île, c’est quoi ?
		</h2>
		<ul class="space-y-3">
			<li>
				<Card class="bg-watt-blue text-white relative overflow-hidden">
					<div class="relative z-10">
						<h3 class="text-2xl font-medium font-pally">
							Accompagner la transition alimentaire
						</h3>
						<Text class="font-medium">
							Faire autrement : production, consommation, travail, gouvernance, répartition des richesses... Commun'ile fait le pari d'une économie au service de l'humain et du vivant, et ancré sur son territoire.
						</Text>
						<Text class="font-pally text-blue-200 font-bold text-2xl balance">
							Défendre un modèle de la fourche à la fourchette
						</Text>
					</div>
					<Image
						src={illuAccompagnerTransitionImage}
						alt="Illustration de la transition alimentaire"
						class="absolute bottom-0 right-0"
					/>
				</Card>
			</li>
			<li>
				<Card class="bg-watt-yellow text-white relative overflow-hidden">
					<div class="relative z-10">
						<h3 class="text-2xl font-medium font-pally mb-3">
							Créer du lien social et favoriser la citoyenneté
						</h3>
						<Text class="font-medium">
							Casser la croûte, se faire des confidences autour d'un verre, vivre l'émotion d'un concert enjaillé, soutenir des initiatives locales... autant de moments qui permettent de tisser des liens avec celles et ceux qu'on connait jamais assez.
						</Text>
						<Text class="font-pally text-yellow-700 font-bold text-2xl balance">
							Provoquer des rencontres et des échanges
						</Text>
					</div>
					<Image
					  src={illuCreerLienImage}
						alt="Illustration de la création de liens sociaux"
						class="absolute bottom-0 right-0"
					/>
				</Card>
			</li>
			<li>
				<Card class="bg-watt-red text-white relative overflow-hidden">
					<div class="relative z-10">
						<h3 class="text-2xl font-medium font-pally mb-3">
							Créer un modèle innovant
						</h3>
						<Text class="font-medium">
							Faire autrement : production, consommation, travail, gouvernance, répartition des richesses... Commun'ile fait le pari d'une économie au service de l'humain et du vivant, et ancré sur son territoire.
						</Text>
						<Text class="font-pally text-red-50 font-bold text-2xl balance">
							Construire une économie alternative et démocratique
						</Text>
					</div>
					<Image
						src={illuCreerModeleImage}
						alt="Illustration de la création d'un modèle innovant"
						class="absolute bottom-0 right-0"
					/>
				</Card>
			</li>
		</ul>
	</Section>

	<Section class="bg-yellow-500 relative overflow-hidden">
		<ShapeWaves01 role="presentation" aria-hidden="true" class="absolute top-0 right-0" />
		<ShapeWaves02 role="presentation" aria-hidden="true" class="absolute bottom-0 left-0" />

		<div class="relative z-10 space-y-6">
			<h2 class="text-2xl text-center font-medium font-pally text-yellow-900">
				Nos valeurs
			</h2>
			<ul class="space-y-6">
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Convivialité
						</Tag>
						<Text>
							Comme un préalable et une première façon de créer du collectif
							<Icon name="home" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Solidarité
						</Tag>
						<Text>
							Comme une évidence, une nécessité
							<Icon name="users" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Inclusion
						</Tag>
						<Text>
							Pour être des lieux de vie et d’expérimentation
							<Icon name="sparkles" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Durabilité
						</Tag>
						<Text>
							Comme un pré-requis non négociable
							<Icon name="sun" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Ancrage local
						</Tag>
						<Text>
							Pour agir en symbiose avec notre environnement
							<Icon name="sprout" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Accessibilité
						</Tag>
						<Text>
							Un mantra pour rendre le choix possible à tous les niveaux
							<Icon name="spell-check" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
			</ul>
		</div>
	</Section>
</Layout>
