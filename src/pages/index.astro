---
import { Image } from 'astro:assets'

import Card from '../components/card.astro'
import Hero from '../components/hero.astro'
import Icon from '../components/icon.astro'
import Link from '../components/link.astro'
import Section from '../components/section.astro'
import Tag from '../components/tag.astro'
import Text from '../components/text.astro'

import Layout from '../layouts/main.astro'

import heroImage from '../images/communile-hero.jpg'
import leBarIleCardImage from '../images/le-bar-ile-card.jpg'
import leLaboDivaCardImage from '../images/le-labo-diva-card.jpg'
import leWattigniesCardImage from '../images/le-wattignies-card.jpg'
import lesLandesFertilesCardImage from '../images/les-landes-fertiles-card.jpg'

import illuAccompagnerTransitionImage from '../images/communile-illu-accompagner-transition.png'
import illuCreerAgirImage from '../images/communile-illu-agir.png'
import illuCreerLienImage from '../images/communile-illu-creer-lien.png'
import illuCreerModeleImage from '../images/communile-illu-creer-modele.png'
import illuNotreButImage from '../images/communile-illu-notre-but.png'
import illuScicImage from '../images/communile-illu-scic.png'
import ShapeHexagon01 from '../images/shape-hexagon-01.svg'
import ShapeHook01 from '../images/shape-hook-01.svg'
import ShapeHook02 from '../images/shape-hook-02.svg'
import ShapeWaves01 from '../images/shape-waves-01.svg'
import ShapeWaves02 from '../images/shape-waves-02.svg'

import { PATH } from '../utils/constants'
---

<Layout>
	<Hero
		title="Archipel de(s) communs"
		image={heroImage}
		imageAlt="Un mur peint avec les couleurs du logo. Le fond est bleu, des plantes rouges serpentent le long du mur. En haut, Commun'île est écrit en gros, en jaune. Les différents noms de lieux sont écrits de part et d'autre, en gris. Des photos Polaroid de différents moments de vie sont collées sur le mur."
	/>

	<Section class="space-y-3">
		<h2 class="grid grid-rows-2 justify-items-start text-white uppercase font-pally font-bold text-5xl leading-normal">
			<span class="inline-block rounded-full bg-primary px-4 -rotate-7">Nos</span>
			<span class="inline-block rounded-full bg-secondary px-4 rotate-4 -translate-y-2">lieux</span>
		</h2>
		
		<Text>
			Commun'île c'est avant tout une histoire de lieux et de personnes qui les composent. 
		</Text>
		<Text>
			Des lieux où chacun·e pourra toujours bien manger, boire un coup et passer du bon temps.
		</Text>
		<Text>
			Des lieux où règne le respect : celui des client·es d'un jour et de toujours, celui des travailleurs, des produits, de notre quartier, de notre ville
		</Text>

		<Link
			href={PATH.LE_WATTIGNIES}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={leWattigniesCardImage}
				alt="Le Wattignies - bar et restaurant avec une façade vitrée, un comptoir bleu et des tables"
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="blue" class="absolute top-4 left-4 uppercase">
					Le Wattignies
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d’ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>

		<Link 
			href={PATH.LES_LANDES_FERTILES}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={lesLandesFertilesCardImage}
				alt="Les Landes Fertiles - 2 personnes travaillent sur des plants de tomates"
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="red" class="absolute top-4 left-4 uppercase">
					Les Landes Fertiles
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d’ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>
		
		<Link
			href={PATH.LE_LABO_DIVA}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={leLaboDivaCardImage}
				alt="Le Labo Diva - Un bar intérieur composé de lattes de bois peintes en vert, jaune, blanc ou orange."
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="green" class="absolute top-4 left-4 uppercase">
					Le Labo Diva
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d'ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>

		<Link
			href={PATH.LE_BAR_ILE}
			class="block relative rounded-2xl overflow-hidden group"
		>
			<Image
				src={leBarIleCardImage}
				alt="Le Bar Ile - Une terrasse d'un bar, les murs extérieurs sont bleus foncés. Un marché est installé avec des légumes."
				class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
				height={256}
			/>
			<span class="group-hover:opacity-0 transition-opacity duration-300">
				<Tag color="blue" class="absolute top-4 left-4 uppercase">
					Le Bar’Île
				</Tag>
				<span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
					<Icon name="arrow-up-right" size="40" />
				</span>
			</span>
			<span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
				<span class="flex flex-col justify-between h-1/2">
					<span class="font-bold text-2xl">
						Horaires d’ouverture
					</span>
					<span class="font-medium">
						Toute la semaine de 10h à 17h
					</span>
				</span>
			</span>
		</Link>
	</Section>

	<Section class="space-y-6">
		<h2 class="text-2xl text-center font-medium font-pally">
			Commun’Île, c’est quoi ?
		</h2>
		<ul class="space-y-3">
			<li>
				<Card class="bg-watt-blue text-white relative overflow-hidden">
					<div class="relative z-10">
						<h3 class="text-2xl font-medium font-pally">
							Accompagner la transition alimentaire
						</h3>
						<Text class="font-medium">
							Faire autrement : production, consommation, travail, gouvernance, répartition des richesses... Commun'ile fait le pari d'une économie au service de l'humain et du vivant, et ancré sur son territoire.
						</Text>
						<Text class="font-pally text-blue-200 font-bold text-2xl balance">
							Défendre un modèle de la fourche à la fourchette
						</Text>
					</div>
					<Image
						src={illuAccompagnerTransitionImage}
						alt="Illustration de la transition alimentaire"
						class="absolute bottom-0 right-0"
					/>
				</Card>
			</li>
			<li>
				<Card class="bg-watt-yellow text-white relative overflow-hidden">
					<div class="relative z-10">
						<h3 class="text-2xl font-medium font-pally mb-3">
							Créer du lien social et favoriser la citoyenneté
						</h3>
						<Text class="font-medium">
							Casser la croûte, se faire des confidences autour d'un verre, vivre l'émotion d'un concert enjaillé, soutenir des initiatives locales... autant de moments qui permettent de tisser des liens avec celles et ceux qu'on connait jamais assez.
						</Text>
						<Text class="font-pally text-yellow-700 font-bold text-2xl balance">
							Provoquer des rencontres et des échanges
						</Text>
					</div>
					<Image
					  src={illuCreerLienImage}
						alt="Illustration de la création de liens sociaux"
						class="absolute bottom-0 right-0"
					/>
				</Card>
			</li>
			<li>
				<Card class="bg-watt-red text-white relative overflow-hidden">
					<div class="relative z-10">
						<h3 class="text-2xl font-medium font-pally mb-3">
							Créer un modèle innovant
						</h3>
						<Text class="font-medium">
							Faire autrement : production, consommation, travail, gouvernance, répartition des richesses... Commun'ile fait le pari d'une économie au service de l'humain et du vivant, et ancré sur son territoire.
						</Text>
						<Text class="font-pally text-red-50 font-bold text-2xl balance">
							Construire une économie alternative et démocratique
						</Text>
					</div>
					<Image
						src={illuCreerModeleImage}
						alt="Illustration de la création d'un modèle innovant"
						class="absolute bottom-0 right-0"
					/>
				</Card>
			</li>
		</ul>
	</Section>

	<Section class="bg-yellow-500 overflow-hidden">
		<ShapeWaves01 role="presentation" aria-hidden="true" class="absolute top-0 right-0" />
		<ShapeWaves02 role="presentation" aria-hidden="true" class="absolute bottom-0 left-0" />

		<div class="relative z-10 space-y-6">
			<h2 class="text-2xl text-center font-medium font-pally text-yellow-900">
				Nos valeurs
			</h2>
			<ul class="space-y-6">
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Convivialité
						</Tag>
						<Text>
							Comme un préalable et une première façon de créer du collectif
							<Icon name="home" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Solidarité
						</Tag>
						<Text>
							Comme une évidence, une nécessité
							<Icon name="users-round" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Inclusion
						</Tag>
						<Text>
							Pour être des lieux de vie et d’expérimentation
							<Icon name="sparkles" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Durabilité
						</Tag>
						<Text>
							Comme un pré-requis non négociable
							<Icon name="sun" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Ancrage local
						</Tag>
						<Text>
							Pour agir en symbiose avec notre environnement
							<Icon name="sprout" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
				<li>
					<Card size="small" radius="diagonal" class="space-y-2">
						<Tag>
							Accessibilité
						</Tag>
						<Text>
							Un mantra pour rendre le choix possible à tous les niveaux
							<Icon name="spell-check" size="40" class="ml-auto p-2" />
						</Text>
					</Card>
				</li>
			</ul>
		</div>
	</Section>

	<Section class="bg-blue-700 overflow-hidden">
		<h2 class="grid grid-rows-3 justify-items-start text-white uppercase font-pally font-bold text-5xl leading-normal mt-6 mb-2"> 
			<span class="inline-block rounded-full bg-primary px-4 -rotate-3">Nous avons</span>
			<span class="inline-block rounded-full bg-secondary px-4 rotate-3 -translate-y-2 translate-x-1 z-10">à cœur</span>
			<span class="inline-block rounded-full bg-tertiary px-4 -rotate-11 -translate-y-6 translate-x-29">d’agir</span>
		</h2>
		
		<div class="relative">
			<ShapeHook01 role="presentation" aria-hidden="true" class="absolute -top-6 -right-6" />
			<ShapeHook02 role="presentation" aria-hidden="true" class="absolute -bottom-8 -left-6" />
			<div class="space-y-6 relative z-10">
				<Card size="small" class="flex items-center gap-2">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="trees" size="24"/>
					</span>
					<Text>
						Par nécessité de sortir nos villes de mouvements infinis de spéculations foncières et de la remettre entre les mains des personnes qui la vivent et la font vivre
					</Text>
				</Card>
				<Card size="small" class="flex items-center gap-2">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="package-2" size="24"/>
					</span>
					<Text>
						Par envie d’offrir à toutes et tous des espaces collectifs générateurs de liens et qui encouragent l’expérimentation
					</Text>
				</Card>
				<Card size="small" class="flex items-center gap-2">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="receipt-euro" size="24"/>
					</span>
					<Text>
						Par ambition de donner à toutes et tous le meilleur, au meilleur prix
					</Text>
				</Card>
				<Card size="small" class="flex items-center gap-2">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="heart-handshake" size="24"/>
					</span>
					<Text>
						Par conviction que notre action ne sera forte que si elle résonne avec le territoire
					</Text>
				</Card>
				<div class="rounded-l-full overflow-hidden h-60 -mr-6">
					<Image
						src={illuCreerAgirImage}
						width={350}
						alt="À l'intérieur du Labo Diva, un marché est installé. Des cageots de courges, blettes, patates douces, salade et autres légumes sont disposés sur des tables. Des petites pancartes noires indiquent les prix des légumes."
						class="h-full w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</Section>

	<Section class="bg-transparent">
		<ShapeHexagon01 role="presentation" aria-hidden="true" class="absolute -top-3 -right-2 w-40 h-auto" />
		<div class="space-y-6 relative z-10">
			<h2 class="grid grid-rows-3 justify-items-start text-white uppercase font-pally font-bold text-5xl leading-normal -mx-3"> 
				<span class="inline-block rounded-full bg-primary px-4 -rotate-7 z-10">Le choix</span>
				<span class="inline-block rounded-full bg-tertiary px-4 -rotate-11 -translate-y-8 translate-x-33">de la</span>
				<span class="inline-block rounded-full bg-secondary px-4 rotate-4 -translate-y-11 translate-x-2">coopérative</span>
			</h2>
			<article class="space-y-4">
				<h3 class="text-2xl font-medium font-pally">
					Commun'île est une SCIC : société coopérative d'intérêt collectif.
				</h3>
				<Text>
					Le choix du statut coopératif traduit la volonté de notre collectif de lier projet politique et activité économique, dans le respect de valeurs démocratique. C'est un choix engageant, de faire économie autrement.
				</Text>
				<Text>
					Tu veux devenir sociétaire ? Contactez-nous pour plus d'information à <Link href="mailto:gerance@communile.fr">gerance@communile.fr</Link>
				</Text>
				<div class="rounded-2xl overflow-hidden h-72">
					<Image
						src={illuScicImage}
						alt="Une photo prise en plongée dans le Labo Diva. Le plan d'un futur bâtiment recouvre une grande table en bois. Des personnes sont debout autour, et participent à un atelier avec des Lego."
						class="h-full w-full object-cover"
						width={330}
					/>
				</div>
			</article>

			<Card size="small" radius="top-right" class="space-y-6">
				<h3 class="flex items-center gap-2 text-center text-2xl font-medium font-pally">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="glasses" size="24"/>
					</span>
					<span class="mx-auto">
						Société commerciale à but non lucratif
					</span>
				</h3>
				<Text>
					La SCIC existe par la constitution d’un capital social. Elle crée un patrimoine commun par la mise en réserves impartageables de ses excédents de gestion.
				</Text>
			</Card>
			<Card size="small" radius="top-right" class="space-y-6">
				<h3 class="flex items-center gap-2 text-center text-2xl font-medium font-pally">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="users-round" size="24"/>
					</span>
					<span class="mx-auto">
						Coopérative : 1 personne = 1 voix
					</span>
				</h3>
				<Text>
					Les coopératives sont caractérisées par des principes et des valeurs universelles : l’humain avant le profit, la prise de décision démocratique, la résilience et le durable...
				</Text>
			</Card>
			<Card size="small" radius="top-right" class="space-y-6">
				<h3 class="flex items-center gap-2 text-center text-2xl font-medium font-pally">
					<span class="inline-block bg-neutral-200 rounded-lg p-2">
						<Icon name="smile" size="24"/>
					</span>
					<span class="mx-auto">
						Intérêt Collectif
					</span>
				</h3>
				<Text>
					C’est une société où participent à la prise de décisions les salarié·es, les usager·es, les partenaires et les collectivités qui en sont parties prenantes et en détiennent le capital sous forme de parts sociales.
				</Text>
			</Card>
		</div>
		<ShapeHexagon01 role="presentation" aria-hidden="true" class="absolute -translate-y-16 -left-16 w-80 h-auto" />
	</Section>

	<Section class="bg-neutral-100 space-y-6">
		<h2 class="grid grid-rows-2 justify-items-start text-white uppercase font-pally font-bold text-5xl leading-normal"> 
			<span class="inline-block rounded-full bg-primary px-4 -rotate-7">Notre</span>
			<span class="inline-block rounded-full bg-secondary px-4 rotate-4 -translate-y-2 translate-x-1 z-10">but</span>
		</h2>
		
		<div class="grid grid-cols-2 text-white rounded-2xl overflow-hidden">
			<div class="bg-slate-800 aspect-square rounded-br-full overflow-hidden" />
			<div class="aspect-square overflow-hidden">
				<Image
					width={165}
					src={illuNotreButImage} 
					alt="Un buffet dans la salle de réception du Labo Diva. Au premier plan des verres à ballons, une jar de cocktail et un percolateur sont posés sur une table. Vue sur l'extérieur du bâtiment, on distingue la grue jaune." 
					class="w-full h-full object-cover"
				/>
			</div>
			<div class="bg-red-500 aspect-square rounded-tl-full flex flex-col pt-16 pb-4 pr-4 pl-8">
				<span class="font-pally font-bold text-3xl">4,8/5</span>
				<span class="font-semibold text-sm mt-1 text-balance">Avis Google (+650 avis)</span>
			</div>
			<div class="bg-yellow-500 aspect-square rounded-tl-full flex flex-col pt-16 pb-4 pr-4 pl-8">
				<span class="font-pally font-bold text-3xl">70%</span>
				<span class="font-semibold text-sm mt-1 text-balance">Référence bio et locales</span>
			</div>
			<div class="bg-green-600 aspect-square rounded-tl-full flex flex-col pt-16 pb-4 pr-4 pl-8">
				<span class="font-pally font-bold text-3xl">+55 000</span>
				<span class="font-semibold text-sm mt-1 text-balance">Personnes accueillis par an</span>
			</div>
			<div class="bg-blue-700 aspect-square rounded-tl-full flex flex-col pt-16 pb-4 pr-4 pl-8">
				<span class="font-pally font-bold text-3xl">+18 300</span>
				<span class="font-semibold text-sm mt-1 text-balance">Repas servis</span>
			</div>
			<div class="bg-red-500 aspect-square rounded-tl-full flex flex-col pt-16 pb-4 pr-4 pl-8">
				<span class="font-pally font-bold text-3xl">+40</span>
				<span class="font-semibold text-sm mt-1 text-balance">Évènements par an</span>
			</div>
			<div class="bg-yellow-500 aspect-square rounded-tl-full flex flex-col pt-16 pb-4 pr-4 pl-8">
				<span class="font-pally font-bold text-3xl">+100</span>
				<span class="font-semibold text-sm mt-1 text-balance">Sociétaires</span>
			</div>
		</div>
	</Section>
</Layout>
