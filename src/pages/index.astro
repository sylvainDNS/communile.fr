---
import Hero from '../components/hero.astro'
import Layout from '../layouts/main.astro'

import heroImage from '../images/communile-hero.jpg'
---

<Layout>
	<Hero
		title="Archipel de(s) communs"
		image={heroImage}
		imageAlt="Un mur peint avec les couleurs du logo. Le fond est bleu, des plantes rouges serpentent le long du mur. En haut, Commun'île est écrit en gros, en jaune. Les différents noms de lieux sont écrits de part et d'autre, en gris. Des photos Polaroid de différents moments de vie sont collées sur le mur."
	/>
</Layout>
