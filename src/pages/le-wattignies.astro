---
import wattigniesWhatImage from '@/features/wattignies/images/wattignies-what.webp'
import WattAvisSection from '@/features/wattignies/sections/watt-avis-section.astro'
import WattBarProgSection from '@/features/wattignies/sections/watt-bar-prog-section.astro'
import WattFaqSection from '@/features/wattignies/sections/watt-faq-section.astro'
import WattHeroSection from '@/features/wattignies/sections/watt-hero-section.astro'
import WattInstagramSection from '@/features/wattignies/sections/watt-instagram-section.astro'
import WattMarchesProducteursSection from '@/features/wattignies/sections/watt-marches-producteurs-section.astro'
import WattMarchesSection from '@/features/wattignies/sections/watt-marches-section.astro'
import WattResidentsSection from '@/features/wattignies/sections/watt-residents-section.astro'
import WattRestaurantSection from '@/features/wattignies/sections/watt-restaurant-section.astro'
import WattCestQuoiSection from '@/features/wattignies/sections/watt-what-section.astro'
import Layout from '../layouts/main.astro'
import { SITE_URL } from '../utils/constants'

const description
  = 'Le Wattignies est un tiers-lieu social à Nantes où la solidarité et l\'inclusion occupent une place centrale. Restaurant, bar, programmation culturelle et 12 structures résidentes de l\'ESS.'

// Schema LocalBusiness JSON-LD
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'Le Wattignies',
  'description': description,
  'url': `${SITE_URL}/le-wattignies`,
  'image': `${SITE_URL}/communile-logo.webp`,
  'telephone': '+33228495939',
  'email': 'wattignies@communile.fr',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Nantes',
    'addressCountry': 'FR',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 47.20422,
    'longitude': -1.546397,
  },
}
---

<Layout theme="wattignies" content={{ title: 'Le Wattignies', description, image: wattigniesWhatImage, jsonLd: localBusinessSchema }}>
  <WattHeroSection />
  <WattCestQuoiSection />
  <WattRestaurantSection />
  <WattBarProgSection />
  <WattResidentsSection />
  <WattMarchesSection />
  <WattMarchesProducteursSection />
  <WattAvisSection />
  <WattFaqSection />
  <WattInstagramSection />
</Layout>
