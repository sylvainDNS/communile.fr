---
import laCartePostaleWhatImage from '@/features/la-carte-postale/images/la-carte-postale-what.webp'
import LaCarePostaleAvisSection from '@/features/la-carte-postale/sections/la-carte-postale-avis-section.astro'
import LaCarePostaleEquipeSection from '@/features/la-carte-postale/sections/la-carte-postale-equipe-section.astro'
import LaCarePostaleFaqSection from '@/features/la-carte-postale/sections/la-carte-postale-faq-section.astro'
import LaCarePostaleHeroSection from '@/features/la-carte-postale/sections/la-carte-postale-hero-section.astro'
import LaCarePostaleInstagramSection from '@/features/la-carte-postale/sections/la-carte-postale-instagram-section.astro'
import LaCarePostaleRestaurantSection from '@/features/la-carte-postale/sections/la-carte-postale-restaurant-section.astro'
import LaCarePostaleWhatSection from '@/features/la-carte-postale/sections/la-carte-postale-what-section.astro'
import Layout from '../layouts/main.astro'
import { SITE_URL } from '../utils/constants'

const description
= `
☀️ Café - Cantine timbrée et partagée
🔵 Coopérative Commun'ile
🌱 Légumes de notre ferme
🕐 Lun-Mar 9h-17h · Mer 9h-20h · Jeu-Ven 9h-23h
📍10 rue de l’île Mabon Nantes
`

// Schema Restaurant JSON-LD
const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  'name': 'À La Carte Postale',
  'description': description,
  'url': `${SITE_URL}/a-la-carte-postale`,
  'image': `${SITE_URL}/communile-logo.webp`,
  'telephone': '+33759557814',
  'email': 'alacartepostale@communile.fr',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Nantes',
    'addressCountry': 'FR',
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 47.207252502441406,
    'longitude': -1.559303,
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday'],
      'opens': '09:00',
      'closes': '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Wednesday'],
      'opens': '09:00',
      'closes': '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Thursday', 'Friday'],
      'opens': '09:00',
      'closes': '23:00',
    },
  ],
  'servesCuisine': 'Végétarien',
  'priceRange': '€€',
}
---

<Layout theme="la-carte-postale" content={{ title: 'À La Carte Postale', description, image: laCartePostaleWhatImage, jsonLd: restaurantSchema }}>
  <LaCarePostaleHeroSection />
  <LaCarePostaleWhatSection />
  <LaCarePostaleRestaurantSection />
  <LaCarePostaleEquipeSection />
  <LaCarePostaleAvisSection />
  <LaCarePostaleFaqSection />
  <LaCarePostaleInstagramSection />
</Layout>
