---
import Card from '../components/card.astro'
import Container from '../components/container.astro'
import LeafletMap from '../components/leaflet-map.astro'
import Section from '../components/section.astro'
import Text from '../components/text.astro'
import Layout from '../layouts/main.astro'
---

<Layout content={{ title: "Contact" }}>
  <Container>
    <Section>
      <h1 class="text-3xl font-bold text-center mb-8">Contactez-nous</h1>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Informations de contact -->
        <div class="space-y-6">
          <Card>
            <h2 class="text-xl font-semibold mb-4">Nos coordonnées</h2>
            <div class="space-y-3">
              <div>
                <Text class="font-semibold">Adresse :</Text>
                <Text>Le Wattignies<br>Rue de Wattignies, 59000 Lille</Text>
              </div>
              <div>
                <Text class="font-semibold">Email :</Text>
                <Text>contact@communile.fr</Text>
              </div>
              <div>
                <Text class="font-semibold">Téléphone :</Text>
                <Text>03 20 XX XX XX</Text>
              </div>
            </div>
          </Card>

          <Card>
            <h2 class="text-xl font-semibold mb-4">Horaires d'ouverture</h2>
            <div class="space-y-2">
              <Text>Lundi - Vendredi : 9h00 - 18h00</Text>
              <Text>Samedi : 10h00 - 16h00</Text>
              <Text>Dimanche : Fermé</Text>
            </div>
          </Card>
        </div>

        <!-- Carte interactive -->
        <div>
          <Card>
            <h2 class="text-xl font-semibold mb-4">Notre localisation</h2>
            <LeafletMap 
              id="contact-map"
              height="400px"
              center={[50.6292, 3.0573]}
              zoom={15}
              markers={[
                {
                  position: [50.6292, 3.0573],
                  popup: '<strong>Le Wattignies</strong><br>Rue de Wattignies<br>59000 Lille'
                }
              ]}
              class="rounded-lg overflow-hidden"
            />
          </Card>
        </div>
      </div>
    </Section>
  </Container>
</Layout>
