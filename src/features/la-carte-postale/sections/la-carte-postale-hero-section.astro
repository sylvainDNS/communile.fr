---
import { Image } from 'astro:assets'
import Container from '@/components/container.astro'
import Section from '@/components/section.astro'
import laCartePostaleHeroDecoration from '../images/la-carte-postale-hero-decoration.svg'
import laCartePostaleHeroLogo from '../images/la-carte-postale-hero-logo.jpg'
---

<Section class="relative overflow-hidden bg-white">
  <Image
    src={laCartePostaleHeroDecoration}
    alt="l'organisation des Landes Fertiles"
    aria-hidden="true"
    class="absolute top-0 left-0 hidden w-[300px] md:block text-primary-accent"
    widths={[200, 400, laCartePostaleHeroDecoration.width]}
  />
  <Image
    src={laCartePostaleHeroDecoration}
    alt="l'organisation des Landes Fertiles"
    aria-hidden="true"
    class="absolute bottom-0 right-0 hidden w-[300px] rotate-180 md:block text-primary-accent"
    widths={[200, 400, laCartePostaleHeroDecoration.width]}
  />
  <Container>
    <div class="flex flex-col justify-between gap-12">
      <div>
        <Image
          widths={[350, 400, 500, laCartePostaleHeroLogo.width]}
          src={laCartePostaleHeroLogo}
          alt="le logo des Landes Fertiles"
          aria-hidden="true"
          class="mx-auto"
        />
      </div>
      <div>
        <h1 class="text-center font-pally text-4xl font-bold text-foreground/90 md:text-5xl">
          Midi Timbré ! Et Cuisines Partagées
        </h1>
      </div>
    </div>
  </Container>
</Section>
