---
import { Image } from 'astro:assets'
import Container from '@/components/container.astro'
import Section from '@/components/section.astro'
import LaCartePostaleHeroDecoration from '../images/la-carte-postale-hero-decoration.svg'
import laCartePostaleHeroLogo from '../images/la-carte-postale-hero-logo.webp'
---

<Section class="relative overflow-hidden bg-white">
  <LaCartePostaleHeroDecoration
    class="absolute bottom-0 right-0 hidden w-[300px] rotate-180 md:block text-primary-accent"
  />

  <LaCartePostaleHeroDecoration class="absolute top-0 left-0 hidden w-[300px] md:block text-secondary-accent" />
  <Container>
    <div class="flex flex-col justify-between gap-12">
      <div>
        <Image
          widths={[350, 400, 500, laCartePostaleHeroLogo.width]}
          src={laCartePostaleHeroLogo}
          alt="le logo des Landes Fertiles"
          aria-hidden="true"
          class="mx-auto"
        />
      </div>
      <div>
        <h1 class="text-center font-pally text-4xl font-bold text-foreground/90 md:text-5xl">
          Cantine-café et midi timbré !
        </h1>
      </div>
    </div>
  </Container>
</Section>
