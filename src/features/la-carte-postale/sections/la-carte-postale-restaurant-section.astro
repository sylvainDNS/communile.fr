---
import { Image } from 'astro:assets'
import Badge from '@/components/badge.astro'
import Container from '@/components/container.astro'
import HeadingBadges from '@/components/heading-badges.astro'
import Icon from '@/components/icon.astro'
import InfoCard from '@/components/info-card.astro'
import Section from '@/components/section.astro'
import Text from '@/components/text.astro'
import ShapeHexagon01 from '@/images/shape-hexagon-01.svg'
import laCartePostaleLeRestaurantImage from '../images/la-carte-postale-le-restaurant.png'
---

<Section variant="transparent" class="space-y-12">
  <ShapeHexagon01
    role="presentation"
    aria-hidden="true"
    class="absolute top-0 right-0 size-[160px] text-secondary-light"
  />

  <Container class="flex flex-col items-start gap-12 md:flex-row relative">
    <ShapeHexagon01
      role="presentation"
      aria-hidden="true"
      class="absolute bottom-[0px] left-[-160px] size-[320px] text-secondary-light"
    />
    <div class="my-auto relative z-20">
      <HeadingBadges rows={3}>
        <Badge variant="primary" rotation="7" class="z-20" size="heading">LE RESTAURANT</Badge>
        <Badge
          variant="secondary"
          rotation="10"
          class="z-30"
          size="heading"
          class="translate-y-0.5 -translate-x-2 z-40 overflow-auto"
        >
          A LA CARTE POSTALE
        </Badge>
      </HeadingBadges>
      <div class="mt-12 text-balance">
        <Text> A La carte Postale c'est une équipe du midi du lundi au vendredi. </Text>
        <Text>
          Sous format cantine, garanti le self le plus cool de la terre (on est comme ça nous, on y croit !)
        </Text>
        <Text>On vous accueille toujours avec la patate, une répartie sans limite et une rapidité conviviale. </Text>
        <Text>Pas de reservations</Text>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 max-w-3xl relative z-20">
      <InfoCard>
        <Icon name="smile" size="24" slot="icon" />
        <Text size="xl" weight="medium" font="pally" slot="title">Du lundi au mercredi : une carte tournante</Text>
        <Text slot="description">
          À la Carte Postale propose une carte végétarienne avec une unique option carné en quantité limité, avec
          quotidiennement de nouveaux plats !
        </Text>
      </InfoCard>
      <InfoCard>
        <Icon name="smile" size="24" slot="icon" />
        <Text size="xl" weight="medium" font="pally" slot="title"> Un espace de Cuisine partagé ! </Text>
        <Text slot="description">
          N’hésitez pas à parler à nos collègues de la mise à disposition de l’espace de cuisine partagé. Pour se tester
          ou se lancer, pour un besoin ponctuel, notre grand espace de production est l’endroit révé pour produire
          ensemble
        </Text>
      </InfoCard>
      <InfoCard>
        <Icon name="smile" size="24" slot="icon" />
        <Text size="xl" weight="medium" font="pally" slot="title"> Mise à disposition de l'espace et animations </Text>
        <Text slot="description">
          Le lieu propose des mises à disposition aux associations et collectifs en après midi. Contactez-nous !
        </Text>
      </InfoCard>
    </div>
  </Container>
  <Container>
    <Image
      src={laCartePostaleLeRestaurantImage}
      alt="La cantine du Labo Diva"
      class="h-full w-full"
      widths={[330, 400, 540, laCartePostaleLeRestaurantImage.width]}
    />
  </Container>
</Section>
