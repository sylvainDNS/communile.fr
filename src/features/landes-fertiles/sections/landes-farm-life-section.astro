---
import { Image } from 'astro:assets'
import Badge from '@/components/badge.astro'
import Container from '@/components/container.astro'
import HeadingBadges from '@/components/heading-badges.astro'
import Icon from '@/components/icon.astro'
import InfoCard from '@/components/info-card.astro'
import Section from '@/components/section.astro'
import landesFarmLifeImage from '@/images/landes-farm-life.png'
import { icons } from '@/utils/icons'
import Text from '../../../components/text.astro'

type InfoCardType = {
  icon: keyof typeof icons
  title: string
  description: string
}

const infoCards: InfoCardType[] = [
  {
    icon: 'smile',
    title: 'Les marchés de producteur.ices',
    description:
      'Tous les mardi au Labo Diva : 16h30-19h30 et tous les mercredi au Wattignies : 16h30-19h30',
  },
  {
    icon: 'smile',
    title: 'Dans nos restaurants',
    description:
      "Nos cuisiniers utilisent les produits que nous cultivons dans les plats gourmands de nos 3 restaurants sur l'île de Nantes. A retrouver au Wattignies, au Bar’île, A la Carte Postale et au Labo Diva.",
  },
]
---

<Section class="bg-transparent">
    <Container
        class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-12 items-start"
    >
        <div class="flex flex-col items-start space-y-6">
            <div>
                <HeadingBadges rows={3}>
                    <Badge
                        size="heading"
                        variant="primary"
                        rotation="-7"
                        class="px-4">PARTICIPER À</Badge
                    >
                    <Badge
                        size="heading"
                        variant="secondary"
                        rotation="-4"
                        class="translate-x-4">LA VIE DE</Badge
                    >
                    <Badge
                        size="heading"
                        variant="tertiary"
                        rotation="-7"
                        class="-translate-y-5 translate-x-24">LA FERME</Badge
                    >
                </HeadingBadges>
            </div>
            <div class="max-w-xl">
                <Text>
                    Vous souhaitez donner un coup de main à la ferme? Vous
                    pouvez joindre Elia, Anaïs, ou toute autre personne à
                    Commun'ile qui se chargera de passer le message ! Nous
                    recevons de temps en temps des coups de main, en fonction
                    des disponibilités des personnes, avec une préférence pour
                    le jeudi. L'important, c'est d'être autonome sur le moyen de
                    transport, et nous on s'occupe du reste.
                </Text>

                <Text>
                    On a généralement des chantiers pour tous les goûts, et on
                    propose un repas partagé le midi.
                </Text>

                <Text>
                    Petit détail qui a son importance : pour être bénévole à la
                    ferme, il faut être sociétaire de Commun'île. Nous sommes là
                    pour en discuter si besoin !
                </Text>
            </div>
        </div>

        <div class="justify-self-center">
            <Image
                src={landesFarmLifeImage}
                alt="Productions des Landes Fertiles"
                class="w-full h-full object-cover max-w-[500px] md:min-w-[400px] rounded-2xl"
                widths={[330, 400, 540, landesFarmLifeImage.width]}
            />
        </div>
    </Container>
</Section>
