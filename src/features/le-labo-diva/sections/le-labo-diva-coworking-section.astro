---
import { Image } from 'astro:assets'
import Badge from '@/components/badge.astro'
import Container from '@/components/container.astro'
import HeadingBadges from '@/components/heading-badges.astro'
import Section from '@/components/section.astro'
import Text from '@/components/text.astro'
import ShapeHexagon01 from '@/images/shape-hexagon-01.svg'
import leLaboDivaCoworkingImage from '../images/le-labo-diva-coworking.png'

const badges = [
  'Accès autonome 7/7j',
  'Système d’alarme',
  'Salle de réunion',
  'Call box',
  'Cuisine partagée',
  'Café/thé offert',
  '18 bureaux',
  '200€ HT/mois',
  'Formules : au mois ou demi-mois',
  '100€ HT/2-3 jours par semaine',
]
---

<Section variant="transparent">
    <ShapeHexagon01
    role="presentation"
    aria-hidden="true"
    class="absolute top-0 right-0 size-[160px] text-secondary-light"
/>
<ShapeHexagon01
    role="presentation"
    aria-hidden="true"
    class="absolute bottom-0 right-1/4 size-[160px] text-secondary-light"
/>
    <Container class="flex flex-col md:flex-row gap-12 items-start relative z-20">
        <div>
            <HeadingBadges rows={3}>
                <Badge
                    variant="secondary"
                    rotation="-7"
                    class="z-20"
                    size="heading"
                >
                    espace
                </Badge>
                <Badge
                    variant="primary"
                    rotation="-12"
                    class="-translate-y-4 z-10"
                    size="heading"
                >
                COWORKING
                </Badge>
            </HeadingBadges>
            <Text font="pally" weight="medium" size="xl" class="mt-6">
                Location d'un poste de travail au coworking du Labo Diva
            </Text>
            <Text>
                Pour développer votre activité dans un espace de coworking convivial et agréable.
            </Text>
            <div class="flex flex-wrap gap-2 max-w-xl">
                {badges.map((badge) => (
                    <Badge variant="neutral" size="md">
                        {badge}
                    </Badge>
                ))}
            </div>
        </div>

        <div class="flex flex-1 w-full">
            <Image
                src={leLaboDivaCoworkingImage}
                alt="Le bar du Wattignies"
                class="w-full h-full"
                widths={[330, 400, 540, leLaboDivaCoworkingImage.width]}
            />
        </div>
    </Container>
</Section>
