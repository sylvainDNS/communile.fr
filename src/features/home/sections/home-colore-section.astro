---
import { Image } from 'astro:assets'
import Card from '@/components/card.astro'
import Container from '@/components/container.astro'
import HeadingGrid from '@/components/heading-grid.astro'
import Icon from '@/components/icon.astro'
import Section from '@/components/section.astro'
import Text from '@/components/text.astro'
import illuCreerAgirImage from '@/images/communile-illu-agir.png'
import ShapeHook01 from '@/images/shape-hook-01.svg'
import ShapeHook02 from '@/images/shape-hook-02.svg'
import { cn } from '@/utils/style'
---

<Section class="bg-primary-accent overflow-hidden relative">
    <Container>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-6 mb-14"
        >
            <HeadingGrid rows={3}>
                <span
                    class="inline-block rounded-full bg-primary px-4 -rotate-3"
                >
                    Nous avons
                </span>
                <span
                    class="inline-block rounded-full bg-secondary px-4 rotate-3 -translate-y-2 translate-x-1 z-10"
                >
                    à cœur
                </span>
                <span
                    class="inline-block rounded-full bg-tertiary px-4 -rotate-11 -translate-y-6 translate-x-29"
                >
                    d’agir
                </span>
            </HeadingGrid>

            <ShapeHook01
                role="presentation"
                aria-hidden="true"
                class="hidden md:block absolute -top-6 -right-6 text-primary"
            />
            <div class="relative lg:col-span-2">
                <div class="space-y-6 relative z-10">
                    <Card size="small" class="flex items-center gap-2">
                        <span
                            class="inline-block bg-neutral-200 rounded-lg p-2"
                        >
                            <Icon name="trees" size="24" />
                        </span>
                        <Text>
                            Par nécessité de sortir nos villes de mouvements
                            infinis de spéculations foncières et de la remettre
                            entre les mains des personnes qui la vivent et la
                            font vivre
                        </Text>
                    </Card>
                    <Card size="small" class="flex items-center gap-2">
                        <span
                            class="inline-block bg-neutral-200 rounded-lg p-2"
                        >
                            <Icon name="package-2" size="24" />
                        </span>
                        <Text>
                            Par envie d’offrir à toutes et tous des espaces
                            collectifs générateurs de liens et qui encouragent
                            l’expérimentation
                        </Text>
                    </Card>
                    <Card size="small" class="flex items-center gap-2">
                        <span
                            class="inline-block bg-neutral-200 rounded-lg p-2"
                        >
                            <Icon name="receipt-euro" size="24" />
                        </span>
                        <Text>
                            Par ambition de donner à toutes et tous le meilleur,
                            au meilleur prix
                        </Text>
                    </Card>
                    <Card size="small" class="flex items-center gap-2">
                        <span
                            class="inline-block bg-neutral-200 rounded-lg p-2"
                        >
                            <Icon name="heart-handshake" size="24" />
                        </span>
                        <Text>
                            Par conviction que notre action ne sera forte que si
                            elle résonne avec le territoire
                        </Text>
                    </Card>
                </div>
            </div>
        </div>

        <ShapeHook02
            role="presentation"
            aria-hidden="true"
            class="absolute -bottom-8 -left-6 text-primary"
        />
    </Container>
    <div
        class={cn(
            "rounded-l-full overflow-hidden h-60 ml-auto -mr-6 relative z-10 max-w-[90%]",
            "2k:container 2k:mx-auto 2k:rounded-2xl",
        )}
    >
        <Image
            src={illuCreerAgirImage}
            height={240}
            widths={[330, 400, 540, 720, illuCreerAgirImage.width]}
            alt="À l'intérieur du Labo Diva, un marché est installé. Des cageots de courges, blettes, patates douces, salade et autres légumes sont disposés sur des tables. Des petites pancartes noires indiquent les prix des légumes."
            class="h-full w-full object-cover"
        />
    </div>
</Section>
