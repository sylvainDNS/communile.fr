---
import Card from '@/components/card.astro'
import Container from '@/components/container.astro'
import Icon from '@/components/icon.astro'
import Section from '@/components/section.astro'
import Tag from '@/components/tag.astro'
import Text from '@/components/text.astro'
import ShapeWaves01 from '@/images/shape-waves-01.svg'
import ShapeWaves02 from '@/images/shape-waves-02.svg'
---

<Section class="bg-yellow-500 overflow-hidden">
    <Container>
        <ShapeWaves01
            role="presentation"
            aria-hidden="true"
            class="absolute top-0 right-0"
        />
        <ShapeWaves02
            role="presentation"
            aria-hidden="true"
            class="absolute bottom-0 left-0"
        />

        <div class="relative z-10 py-6 space-y-6">
            <h2
                class="text-4xl text-center font-medium font-pally text-foreground/70"
            >
                Nos valeurs
            </h2>
            <ul class="grid auto-rows-fr grid-cols-1 md:grid-cols-3 gap-6">
                <li>
                    <Card
                        size="small"
                        radius="diagonal"
                        class="space-y-2 h-full"
                    >
                        <Tag> Convivialité </Tag>
                        <Text>
                            Comme un préalable et une première façon de créer du
                            collectif
                            <Icon name="home" size="40" class="ml-auto p-2" />
                        </Text>
                    </Card>
                </li>
                <li>
                    <Card
                        size="small"
                        radius="diagonal"
                        class="space-y-2 h-full"
                    >
                        <Tag> Solidarité </Tag>
                        <Text>
                            Comme une évidence, une nécessité
                            <Icon
                                name="users-round"
                                size="40"
                                class="ml-auto p-2"
                            />
                        </Text>
                    </Card>
                </li>
                <li>
                    <Card
                        size="small"
                        radius="diagonal"
                        class="space-y-2 h-full"
                    >
                        <Tag> Inclusion </Tag>
                        <Text>
                            Pour être des lieux de vie et d’expérimentation
                            <Icon
                                name="sparkles"
                                size="40"
                                class="ml-auto p-2"
                            />
                        </Text>
                    </Card>
                </li>
                <li>
                    <Card
                        size="small"
                        radius="diagonal"
                        class="space-y-2 h-full"
                    >
                        <Tag> Durabilité </Tag>
                        <Text>
                            Comme un pré-requis non négociable
                            <Icon name="sun" size="40" class="ml-auto p-2" />
                        </Text>
                    </Card>
                </li>
                <li>
                    <Card
                        size="small"
                        radius="diagonal"
                        class="space-y-2 h-full"
                    >
                        <Tag> Ancrage local </Tag>
                        <Text>
                            Pour agir en symbiose avec notre environnement
                            <Icon name="sprout" size="40" class="ml-auto p-2" />
                        </Text>
                    </Card>
                </li>
                <li>
                    <Card
                        size="small"
                        radius="diagonal"
                        class="space-y-2 h-full"
                    >
                        <Tag> Accessibilité </Tag>
                        <Text>
                            Un mantra pour rendre le choix possible à tous les
                            niveaux
                            <Icon
                                name="spell-check"
                                size="40"
                                class="ml-auto p-2"
                            />
                        </Text>
                    </Card>
                </li>
            </ul>
        </div>
    </Container>
</Section>
