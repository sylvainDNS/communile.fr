---
import { Image } from 'astro:assets'
import Icon from '@/components/icon.astro'
import Link from '@/components/link.astro'
import Tag from '@/components/tag.astro'

export interface Props {
  href: string
  image: ImageMetadata
  imageAlt: string
  tagColor: 'blue' | 'red' | 'green'
  tagText: string
  class?: string
}

const {
  href,
  image,
  imageAlt,
  tagColor,
  tagText,
  class: className = '',
} = Astro.props
---

<Link
    href={href}
    class={`block relative rounded-2xl overflow-hidden group ${className}`}
>
    <Image
        src={image}
        alt={imageAlt}
        class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
        widths={[330, 400, 540, 720, image.width]}
    />
    <span class="group-hover:opacity-0 transition-opacity duration-300">
        <Tag color={tagColor} class="absolute top-4 left-4 uppercase">
            {tagText}
        </Tag>
        <span class="absolute bg-white rounded-full p-2 bottom-4 right-4">
            <Icon name="arrow-up-right" size="40" />
        </span>
    </span>
    <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute inset-0 p-4 bg-black/80 text-white text-center">
        <span class="flex flex-col justify-between h-1/2">
            <slot name="hover-content" />
        </span>
    </span>
</Link>
