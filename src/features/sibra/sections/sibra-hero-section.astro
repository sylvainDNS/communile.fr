---
import Container from '@/components/container.astro'
import Section from '@/components/section.astro'
import SibraHeroDeco from '../images/sibra-hero-decoration.svg'
---

<Section class="relative overflow-hidden bg-white">
  <SibraHeroDeco class="absolute top-0 left-0 hidden w-[300px] md:block text-secondary-accent" aria-hidden="true" />
  <SibraHeroDeco
    class="absolute bottom-0 right-0 hidden w-[300px] rotate-180 md:block text-primary-accent"
    aria-hidden="true"
  />
  <Container>
    <div class="flex flex-col items-center gap-12">
      <div class="flex flex-col items-center gap-4">
        {/* TODO logo : remplacer par le logo de La Sibra dès réception */}
        <svg
          width="112"
          height="112"
          viewBox="0 0 231 231"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="88" cy="78" r="78" class="fill-tertiary" />
          <circle cx="158" cy="118" r="72" class="fill-secondary" />
          <circle cx="96" cy="164" r="66" class="fill-primary" />
        </svg>
        <p class="text-center font-pally text-2xl font-bold md:text-3xl">La Sibra</p>
      </div>
      <h1 class="text-center font-pally text-4xl font-bold md:text-5xl">De l’houblon à la pression</h1>
    </div>
  </Container>
</Section>
