---
import { Image } from 'astro:assets'
import Container from '@/components/container.astro'
import Section from '@/components/section.astro'
import heroImage from '../images/wattignies-hero.webp'

import wattigniesOrnamentImage from '../images/wattignies-ornament.webp'
---

<Section overflow="hidden" class="relative">
  <Image
    src={wattigniesOrnamentImage}
    alt="l'organisation du Wattignies"
    aria-hidden="true"
    class="absolute -top-8 -left-8 hidden w-[300px] opacity-30 md:block"
    widths={[200, 400, 600]}
    loading="lazy"
  />
  <Image
    src={wattigniesOrnamentImage}
    alt="l'organisation du Wattignies"
    aria-hidden="true"
    class="absolute -right-8 -bottom-8 hidden w-[300px] rotate-180 opacity-30 md:block"
    widths={[200, 400, 600]}
    loading="lazy"
  />
  <Container class="py-12">
    <div class="flex flex-col justify-center">
      <div>
        <Image
          height={500}
          widths={[350, 400, 540, 720, 960, 1280]}
          src={heroImage}
          alt="le logo du Wattignies"
          aria-hidden="true"
          class="max-h-[400px] w-full scale-110 object-cover object-center md:scale-100"
          fetchpriority="high"
        />
      </div>
      <div>
        <h1 class="text-center font-pally text-4xl font-bold text-foreground/90 md:text-5xl">
          Bouillon social et culturel
        </h1>
      </div>
    </div>
  </Container>
</Section>
