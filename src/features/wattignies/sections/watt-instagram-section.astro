---
import Container from '@/components/container.astro'
import InstagramFeed from '@/components/instagram-feed.astro'
import Section from '@/components/section.astro'
---

<Section class="py-24">
    <Container class="grid grid-cols-1 gap-6">
        <div class="text-center">
            <h2 class="font-pally text-4xl font-bold mb-2">Retrouvez-nous sur Instagram</h2>
        </div>
        
        <InstagramFeed 
            username="wattigniesnantes" 
            useWidget={true}
            class="min-h-[400px] sm:min-h-[600px] md:min-h-[800px] xl:min-h-[1000px]"
        />
    </Container>
</Section>



