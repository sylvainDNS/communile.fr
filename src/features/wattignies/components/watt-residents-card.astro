---
import { Image } from 'astro:assets'
import Tag from '@/components/tag.astro'

interface Props {
  image: ImageMetadata
  title: string
  description: string
  tagColor: 'blue' | 'green' | 'red' | 'yellow' | 'neutral'
  alt: string
}

const { image, title, description, tagColor, alt } = Astro.props
---

<div class="relative w-full max-w-[404px] h-[260px] rounded overflow-hidden">
  <Image 
    src={image} 
    alt={alt} 
    class="w-full h-full object-cover"
    width={404}
    height={260}
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
  <div class="absolute top-4 left-4">
    <Tag color={tagColor} class="text-xl md:text-2xl font-pally font-medium">{title}</Tag>
  </div>
  <div class="absolute bottom-4 left-4 right-4">
    <div class="bg-black/80 rounded p-2">
      <p class="text-white text-center font-inter font-medium text-sm md:text-base">{description}</p>
    </div>
  </div>
</div>

