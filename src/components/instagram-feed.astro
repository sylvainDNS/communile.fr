---
import { cn } from '../utils/style'

export interface Props {
  username: string
  class?: string
}

const { username, class: className } = Astro.props
---

<div class={cn('instagram-widget', className)}>
  <iframe
    src={`https://www.instagram.com/${username}/embed/`}
    width="100%"
    height="400"
    allowtransparency="true"
    class="h-full max-w-5xl min-h-[600px] md:min-h-[800px] xl:min-h-[900px] mx-auto rounded-lg"
    title={`Feed Instagram de @${username}`}
  ></iframe>
</div>
