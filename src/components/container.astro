---
import type { HTMLAttributes } from 'astro/types'
import { cva, type VariantProps } from 'class-variance-authority'

import { cn } from '../utils/style'

const containerVariants = cva('mx-auto', {
  variants: {
    size: {
      sm: 'max-w-screen-sm',
      md: 'max-w-screen-md',
      lg: 'max-w-screen-lg',
      xl: 'max-w-screen-xl',
      '2xl': 'max-w-screen-2xl',
      full: 'max-w-full',
      container: 'container',
    },
    padding: {
      none: '',
      sm: 'p-4',
      md: 'p-6',
      lg: 'p-8',
      xl: 'p-12',
    },
  },
  defaultVariants: {
    size: 'container',
    padding: 'none',
  },
})

type Props = HTMLAttributes<'div'> & VariantProps<typeof containerVariants>
const { class: className, size, padding, ...delegated } = Astro.props
---

<div class={cn(containerVariants({ size, padding }), className)} {...delegated}>
    <slot />
</div>