---
import { Image } from 'astro:assets'

import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'

import { cn } from '../utils/style'
import Section from './section.astro'

interface Props extends HTMLAttributes<'section'> {
  title: string
  image: ImageMetadata
  imageAlt: string
}

const {
  title,
  image,
  imageAlt = '',
  class: className,
  ...delegated
} = Astro.props
---

<Section class={cn('space-y-6 bg-transparent p-0 md:px-6', className)} {...delegated}>
  <h1 class="text-2xl font-bold text-center">
    {title}
  </h1>

  <div class="block relative rounded-2xl overflow-hidden">
    <Image 
      src={image}
      alt={imageAlt}
      height={435}
      widths={[330, 400, 540, 720, image.width]}
      class="w-full object-cover max-h-[435px] object-top"
    />
  </div>
</Section> 