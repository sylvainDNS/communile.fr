---
import { cn } from '../utils/style'

export interface Props {
  id?: string
  class?: string
  height?: string
  center?: [number, number]
  zoom?: number
  markers?: Array<{
    position: [number, number]
    popup?: string
    icon?: string
  }>
  tileLayer?: {
    url: string
    attribution: string
    maxZoom?: number
  }
  showControls?: boolean
  scrollWheelZoom?: boolean
  dragging?: boolean
  touchZoom?: boolean
  doubleClickZoom?: boolean
  boxZoom?: boolean
  keyboard?: boolean
  loadingText?: string
  errorText?: string
}

const {
  id = 'leaflet-map',
  class: className,
  height = '400px',
  center = [51.505, -0.09],
  zoom = 13,
  markers = [],
  tileLayer = {
    url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
    attribution:
      '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  },
  showControls = true,
  scrollWheelZoom = true,
  dragging = true,
  touchZoom = true,
  doubleClickZoom = true,
  boxZoom = true,
  keyboard = true,
  loadingText = 'Chargement de la carte...',
  errorText = 'Erreur lors du chargement de la carte',
} = Astro.props
---

<div class={cn('relative', className)}>
  <!-- Skeleton de chargement -->
  <div 
    id={`${id}-skeleton`}
    class="absolute inset-0 bg-gray-200 animate-pulse rounded-lg flex items-center justify-center z-10"
    style={{ height }}
  >
    <div class="text-center">
      <div class="w-8 h-8 border-4 border-gray-300 border-t-blue-600 rounded-full animate-spin mx-auto mb-2"></div>
      <p class="text-gray-600 text-sm">{loadingText}</p>
    </div>
  </div>

  <!-- Conteneur de la carte -->
  <div 
    id={id}
    class="w-full rounded-lg"
    style={{ height }}
  ></div>

  <!-- Message d'erreur (caché par défaut) -->
  <div 
    id={`${id}-error`}
    class="absolute inset-0 bg-red-50 border border-red-200 rounded-lg items-center justify-center z-20 hidden"
    style={{ height }}
  >
    <div class="text-center">
      <div class="w-8 h-8 text-red-500 mb-2">
        <svg fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="text-red-600 text-sm">{errorText}</p>
    </div>
  </div>
</div>

<script define:vars={{ id, center, zoom, markers, tileLayer, showControls, scrollWheelZoom, dragging, touchZoom, doubleClickZoom, boxZoom, keyboard }}>
  // Configuration de la carte
  const mapConfig = {
    id: document.getElementById(id),
    center: center,
    zoom: zoom,
    markers: markers,
    tileLayer: tileLayer,
    controls: {
      showControls: showControls,
      scrollWheelZoom: scrollWheelZoom,
      dragging: dragging,
      touchZoom: touchZoom,
      doubleClickZoom: doubleClickZoom,
      boxZoom: boxZoom,
      keyboard: keyboard
    }
  }

  function initMap() {
    try {
      if (typeof L === 'undefined') {
        throw new Error('Leaflet library not loaded')
      }

      const map = L.map(mapConfig.id).setView(mapConfig.center, mapConfig.zoom)

      if (!mapConfig.controls.scrollWheelZoom) map.scrollWheelZoom.disable()
      if (!mapConfig.controls.dragging) map.dragging.disable()
      if (!mapConfig.controls.touchZoom) map.touchZoom.disable()
      if (!mapConfig.controls.doubleClickZoom) map.doubleClickZoom.disable()
      if (!mapConfig.controls.boxZoom) map.boxZoom.disable()
      if (!mapConfig.controls.keyboard) map.keyboard.disable()

      L.tileLayer(mapConfig.tileLayer.url, {
        maxZoom: mapConfig.tileLayer.maxZoom,
        attribution: mapConfig.tileLayer.attribution
      }).addTo(map)

      mapConfig.markers.forEach((markerData) => {
        const marker = L.marker(markerData.position).addTo(map)
        
        if (markerData.popup) {
          marker.bindPopup(markerData.popup)
        }
      })

      const skeleton = document.getElementById(`${id}-skeleton`)
      if (skeleton) {
        skeleton.style.display = 'none'
      }

      setTimeout(() => {
        map.invalidateSize()
      }, 100)

    } catch (error) {
      console.error('Erreur lors de l\'initialisation de la carte:', error)
      
      const skeleton = document.getElementById(`${id}-skeleton`)
      const errorDiv = document.getElementById(`${id}-error`)
      
      if (skeleton) skeleton.style.display = 'none'
      if (errorDiv) {
        errorDiv.classList.remove('hidden')
        errorDiv.classList.add('flex')
      }
    }
  }

  function loadLeaflet() {
    return new Promise((resolve, reject) => {
      if (typeof L !== 'undefined') {
        resolve(L)
        return
      }

      const cssLink = document.createElement('link')
      cssLink.rel = 'stylesheet'
      cssLink.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
      cssLink.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY='
      cssLink.crossOrigin = ''
      document.head.appendChild(cssLink)

      const script = document.createElement('script')
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
      script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo='
      script.crossOrigin = ''
      
      script.onload = () => {
        setTimeout(() => resolve(L), 100)
      }
      
      script.onerror = () => {
        reject(new Error('Failed to load Leaflet library'))
      }
      
      document.head.appendChild(script)
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      loadLeaflet()
        .then(() => initMap())
        .catch((error) => {
          console.error('Erreur lors du chargement de Leaflet:', error)
          const skeleton = document.getElementById(`${id}-skeleton`)
          const errorDiv = document.getElementById(`${id}-error`)
          
          if (skeleton) skeleton.style.display = 'none'
          if (errorDiv) {
            errorDiv.classList.remove('hidden')
            errorDiv.classList.add('flex')
          }
        })
    })
  } else {
    loadLeaflet()
      .then(() => initMap())
      .catch((error) => {
        console.error('Erreur lors du chargement de Leaflet:', error)
        const skeleton = document.getElementById(`${id}-skeleton`)
        const errorDiv = document.getElementById(`${id}-error`)
        
        if (skeleton) skeleton.style.display = 'none'
        if (errorDiv) {
          errorDiv.classList.remove('hidden')
          errorDiv.classList.add('flex')
        }
      })
  }
</script>
