---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '../utils/style'

type Props = HTMLAttributes<'span'> & {
  color?: 'blue' | 'green' | 'red' | 'yellow' | 'neutral'
}

const { color = 'neutral', class: className, ...delegated } = Astro.props
---

<span 
class={cn(
    'inline-block px-3 py-2 rounded-full font-bold leading-normal text-base',
    {
      'bg-gradient-to-bl to-primary-light from-[color-mix(in_oklab,var(--theme-primary)_15%,var(--color-white))] text-primary': color === 'blue',
      'bg-gradient-to-bl to-secondary-light from-[color-mix(in_oklab,var(--theme-secondary)_15%,var(--color-white))] text-secondary': color === 'green',
      'bg-gradient-to-bl to-tertiary-light from-[color-mix(in_oklab,var(--theme-tertiary)_15%,var(--color-white))] text-tertiary': color === 'red',
      'bg-gradient-to-bl to-quaternary-light from-[color-mix(in_oklab,var(--theme-quaternary)_15%,var(--color-white))] text-quaternary': color === 'yellow',
      'bg-background text-foreground': color === 'neutral',
    },
    className
  )}
  {...delegated}
>
	<slot />
</span>
