---
import { Image } from 'astro:assets'
import { cn } from '@/utils/style'
import Tag from './tag.astro'

interface Props {
  image: ImageMetadata
  title: string
  description: string
  tagColor: 'blue' | 'green' | 'red' | 'yellow' | 'neutral'
  alt: string
  class?: string
  href?: string
}

const { image, title, description, tagColor, alt, class: className, href } = Astro.props
---

<a href={href} target="_blank" class="cursor-pointer">
  <div class={cn('group/residents relative w-full max-w-[400px] h-[260px] rounded overflow-hidden', className)}>
    <Image
      src={image}
      alt={alt}
      class="h-full w-full object-cover object-center transition-transform duration-300 group-hover/residents:scale-105 group-hover/residents:-rotate-2"
      width={404}
      height={260}
    />
    <div class="absolute top-4 left-4 z-50 transition-transform duration-300 group-hover/residents:rotate-1">
      <Tag data-slot="title" color={tagColor} class="font-pally text-xl font-medium whitespace-nowrap md:text-2xl"
        >{title}</Tag
      >
    </div>
    <div class="absolute right-4 bottom-4 left-4">
      <div class="rounded bg-black/80 p-2">
        <p class="font-inter text-center text-sm font-medium text-white md:text-base">
          {description}
        </p>
      </div>
    </div>
  </div>
</a>
