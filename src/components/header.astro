---
import { Image } from 'astro:assets'

import logo from '../images/communile-logo.png'
import { PATH, SITE_NAME } from '../utils/constants'

import Button from './button.astro'
import Icon from './icon.astro'
import Link from './link.astro'
import NavLink from './nav-link.astro'
import VisuallyHidden from './visually-hidden.astro'

const pathname = new URL(Astro.request.url).pathname

const links = [
  {
    label: 'Qui sommes-nous ?',
    href: PATH.HOME,
  },
  {
    label: 'Le Wattignies',
    href: PATH.LE_WATTIGNIES,
  },
  {
    label: 'Les Landes Fertiles',
    href: PATH.LES_LANDES_FERTILES,
  },
  {
    label: 'Le Labo Diva',
    href: PATH.LE_LABO_DIVA,
  },
]
---

<header
    class="fixed inset-x-2 md:inset-x-4 top-2 z-50 rounded-md bg-white max-w-2k mx-auto"
>
    <div class="container mx-auto px-4 py-3 relative z-50">
        <div class="grid grid-cols-2 md:grid-cols-[1fr_auto_1fr] items-center">
            <Link
                href={PATH.HOME}
                class="font-bold uppercase text-neutral-800 hover:text-neutral-700 flex items-center gap-3"
            >
                <Image
                    src={logo}
                    alt=""
                    aria-hidden="true"
                    role="presentation"
                    width={40}
                    height={40}
                />
                {SITE_NAME}
            </Link>
            <nav class="hidden md:block" aria-label="Navigation principale">
                <ul class="flex items-center gap-0.5">
                    {
                        links.map((link) => (
                            <li>
                                <NavLink
                                    active={pathname === link.href}
                                    href={link.href}
                                >
                                    {link.label}
                                </NavLink>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <div class="justify-self-end">
                <Button
                    id="mobile-menu-button"
                    aria-controls="mobile-overlay"
                    aria-expanded="false"
                    type="button"
                    variant="ghost"
                    class="block md:hidden p-2 text-foreground rounded-sm hover:bg-background"
                >
                    <VisuallyHidden>Menu</VisuallyHidden>
                    <Icon name="menu" size={24} />
                </Button>
            </div>
        </div>

        <div
            id="mobile-overlay"
            class="fixed left-2 right-2 mt-4 shadow-xl h-[calc(100vh-var(--mobile-overlay-top)-calc(var(--spacing)*5))] z-40 hidden md:hidden md:data-[visible=true]:hidden data-[visible=true]:block"
            style="top: var(--mobile-overlay-top, 0px)"
        >
            <div
                id="mobile-panel"
                role="dialog"
                aria-modal="true"
                class="relative h-full w-full flex items-stretch justify-start overflow-hidden"
            >
                <div
                    class="relative z-10 h-full w-full max-w-md bg-white rounded-md flex flex-col"
                >
                    <nav
                        aria-label="Navigation mobile"
                        class="flex justify-center items-center flex-1 pt-2 px-2 overflow-y-auto"
                    >
                        <ul
                            class="space-y-2 flex flex-col justify-center items-center gap-2 text-xl"
                        >
                            {
                                links.map((link) => (
                                    <li>
                                        <NavLink
                                            active={pathname === link.href}
                                            href={link.href}
                                        >
                                            {link.label}
                                        </NavLink>
                                    </li>
                                ))
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
        <script>
            import { icons } from "@/utils/icons";
            import { animate, svg } from "animejs";

            const btn = document.getElementById(
                "mobile-menu-button",
            ) as HTMLElement | null;

            const overlay = document.getElementById("mobile-overlay");
            const panel = document.getElementById("mobile-panel");
            const headerRoot = document.querySelector("header");

            let isOpen = false;
            let focusRestoreEl: HTMLElement | null = null;

            // Icon paths from the icon component
            const menuIconPaths = icons.menu.paths;
            const crossIconPaths = icons.cross.paths;

            // Create reusable target path elements for morphing (simpler and faster than recreating each time)
            function createPathEl(d: string) {
                const el = document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "path",
                );
                el.setAttribute("d", d);
                return el;
            }

            const menuTargets = menuIconPaths.map(createPathEl);
            const crossTargets = crossIconPaths.map(createPathEl);

            function openMenu() {
                if (isOpen) return;
                isOpen = true;
                focusRestoreEl = document.activeElement as HTMLElement | null;

                overlay?.setAttribute("data-visible", "true");
                // Position overlay just below header
                const headerHeight =
                    headerRoot?.getBoundingClientRect().height || 0;
                if (overlay)
                    overlay.style.setProperty(
                        "--mobile-overlay-top",
                        `${headerHeight}px`,
                    );
                btn?.setAttribute("aria-expanded", "true");

                if (!panel) return;

                animate(panel, {
                    clipPath: ["inset(0% 0% 100% 0%)", "inset(0% 0% 0% 0%)"],
                    duration: 300,
                    ease: "inExpo",
                });

                morphMenuIcon(btn, true);

                const firstFocusable = overlay?.querySelector("a, button");
                if (firstFocusable instanceof HTMLElement)
                    firstFocusable.focus();
            }

            function closeMenu() {
                if (!isOpen) return;
                isOpen = false;

                btn?.setAttribute("aria-expanded", "false");

                let completed = 0;
                const done = () => {
                    completed += 1;
                    if (completed >= 2) {
                        overlay?.setAttribute("data-visible", "false");
                        if (focusRestoreEl instanceof HTMLElement)
                            focusRestoreEl.focus();
                    }
                };

                if (!panel) return;

                animate(panel, {
                    clipPath: ["inset(0% 0% 0% 0%)", "inset(0% 0% 100% 0%)"],
                    duration: 250,
                    ease: "inBack",
                    onComplete: done,
                });

                morphMenuIcon(btn, false);
            }

            function morphMenuIcon(
                targetBtn: HTMLElement | null,
                isX: boolean,
            ) {
                const svgElement = targetBtn?.querySelector("svg");
                if (!svgElement) return;
                const paths = svgElement.querySelectorAll("path");

                if (paths.length < 3) return;

                const middle = paths[0];
                const top = paths[1];
                const bottom = paths[2];

                if (isX) {
                    // Morph to cross icon
                    // Hide middle line
                    animate(middle, {
                        opacity: 0,
                        duration: 150,
                        ease: "ease-in-out",
                    });

                    // Morph top line to first diagonal
                    animate(top, {
                        d: svg.morphTo(crossTargets[0]),
                        duration: 260,
                        ease: "ease-in-out",
                    });

                    // Morph bottom line to second diagonal
                    animate(bottom, {
                        d: svg.morphTo(crossTargets[1]),
                        duration: 260,
                        ease: "ease-in-out",
                    });
                } else {
                    // Morph back to menu icon
                    // Show middle line
                    animate(middle, {
                        opacity: 1,
                        duration: 150,
                        ease: "ease-in-out",
                    });

                    // Morph first diagonal back to top line
                    animate(top, {
                        d: svg.morphTo(menuTargets[1]),
                        duration: 260,
                        ease: "ease-in-out",
                    });

                    // Morph second diagonal back to bottom line
                    animate(bottom, {
                        d: svg.morphTo(menuTargets[2]),
                        duration: 260,
                        ease: "ease-in-out",
                    });
                }
            }

            btn?.addEventListener("click", () => {
                if (isOpen) closeMenu();
                else openMenu();
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && isOpen) {
                    e.preventDefault();
                    closeMenu();
                }
            });
        </script>
    </div>
</header>
