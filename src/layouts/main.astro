---
import Footer from '../components/footer.astro'
import Header from '../components/header.astro'
import { SITE_NAME } from '../utils/constants'
import '../styles/global.css'

interface Props {
  content?: {
    title?: string
  }
  theme?: 'default' | 'wattignies' | 'landes-fertiles' | 'labo-diva' | 'bar-ile'
}

const { content, theme } = Astro.props

const title = content?.title ? `${content.title} · ${SITE_NAME}` : SITE_NAME
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body data-theme={theme} class="min-h-screen bg-background px-2 pb-4 text-foreground md:px-4">
    <Header />
    <main class="mx-auto my-4 mt-22 grid max-w-2k grid-cols-1 gap-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
