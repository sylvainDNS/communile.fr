---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import Footer from '../components/footer.astro'
import Header from '../components/header.astro'
import { DEFAULT_DESCRIPTION, SITE_NAME, SITE_URL } from '../utils/constants'
import '../styles/global.css'

interface Props {
  content?: {
    title?: string
    description?: string
    jsonLd?: Record<string, unknown>
    image?: ImageMetadata
  }
  theme?: 'default' | 'wattignies' | 'landes-fertiles' | 'labo-diva' | 'bar-ile' | 'la-carte-postale'
  noindex?: boolean
}

const { content, theme, noindex = false } = Astro.props

const title = content?.title ? `${content.title} · ${SITE_NAME}` : SITE_NAME
const description = content?.description || DEFAULT_DESCRIPTION
const canonicalURL = new URL(Astro.url.pathname, SITE_URL)

let ogImageUrl = `${SITE_URL}/communile-logo.webp`
if (content?.image) {
  const optimizedImage = await getImage({ src: content.image, width: 1200 })
  ogImageUrl = new URL(optimizedImage.src, Astro.url).href
}

let jsonLd = content?.jsonLd
if (!jsonLd) {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    'name': SITE_NAME,
    'url': SITE_URL,
    'logo': `${SITE_URL}/communile-logo.webp`,
    'description': DEFAULT_DESCRIPTION,
    'email': 'contact@communile.fr',
    'sameAs': [],
  }
}
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="fr_FR" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalURL.href} />

    {/* Schema.org JSON-LD - Organization */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <slot name="head" />

    {
      import.meta.env.PROD && (
        <script
          is:inline
          slot="head"
          defer
          data-domain="communile.fr"
          data-api="/mix/load/event"
          src="/mix/load/script.js"
        ></script>

        <script>
  declare global {
    interface Window {
      plausible: any
    }
  }

  window.plausible
    = window.plausible
      || function () {
      // eslint-disable-next-line prefer-rest-params
        ;(window.plausible.q = window.plausible.q || []).push(arguments)
      }
  </script>
    )
}
  </head>
  <body data-theme={theme} class="min-h-screen bg-background px-2 pb-4 text-foreground md:px-4">
    <Header />
    <main class="mx-auto my-4 mt-22 grid max-w-2k grid-cols-1 gap-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
